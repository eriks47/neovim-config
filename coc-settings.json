{
  "inlayHint.enable": false,
  "inlayHint.display": false,
  "suggest.virtualText": false,
  "suggest.maxCompleteItemCount": 256,
  "suggest.removeDuplicateItems": true,
  "clangd.arguments": [
    "--enable-config",
    "--header-insertion=never",
    "--clang-tidy",
    "--background-index",
    "--cross-file-rename"
  ],
  "diagnostic.warningSign": " ",
  "diagnostic.errorSign": " ",
  "suggest.enableFloat": true,
  "outline.previewMaxWidth": 30,
  "suggest.completionItemKindLabels": {
    "field": " ",
    "method": " ",
    "function": "󰆧 ",
    "property": " ",
    "keyword": " ",
    "struct": " ",
    "class": " ",
    "text": " ",
    "default": " ",
    "enum": " ",
    "variable": " ",
    "reference": " ",
    "constant": " ",
    "enumMember": " ",
    "typeParameter": " ",
    "folder": " ",
    "file": " ",
    "snippet": " ",
    "interface": " ",
    "color": " ",
    "module": "󰏗 ",
    "unit": "󰊱 ",
    "value": "v",
    "event": "e",
    "operator": " "
  },
  "suggest.formatItems": ["kind", "abbr", "menu"],
  "suggest.labelMaxLength": 30,
  // "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "emmet.includeLanguages": {"htmldjango": "html"},
  "semanticTokens.enable": true,
  "diagnostic.enableHighlightLineNumber": false,
  "snippets.ultisnips.pythonPrompt": false,
  "snippets.ultisnips.enable": true,
  "snippets.ultisnips.directories": [
      "/home/erik/.config/ultisnips"
  ],
  "clangd.enabled": true,
  "clangd.compilationDatabaseCandidates": ["Build", "build", "bin"],
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.numThreads": 5,
  "rust-analyzer.disableProgressNotifications": true,
  "rust-analyzer.trace.server": "verbose"
}
